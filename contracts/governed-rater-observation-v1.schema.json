{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextualwisdomlab.github.io/fast-mlsirm/contracts/governed-rater-observation-v1.schema.json",
  "title": "CWL Governed Rater Observation v1",
  "description": "Domain-neutral criterion observations from exactly one rater invocation. Scores, placements, certifications, and decisions are intentionally outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "invocation_ref",
    "configuration",
    "task_revision_ref",
    "rubric_revision_ref",
    "response_evidence_ref",
    "observations"
  ],
  "properties": {
    "contract_id": {
      "const": "cwl_governed_rater_observation/v1"
    },
    "invocation_ref": {
      "$ref": "#/$defs/reference"
    },
    "configuration": {
      "$ref": "#/$defs/rater_configuration"
    },
    "task_revision_ref": {
      "$ref": "#/$defs/reference"
    },
    "rubric_revision_ref": {
      "$ref": "#/$defs/reference"
    },
    "response_evidence_ref": {
      "$ref": "#/$defs/reference"
    },
    "observations": {
      "description": "Criterion observations keyed by the canonical criterion_ref. Keying makes criterion identity unique in the published JSON data model; consumers must reject duplicate JSON object member names before schema validation.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/reference"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/observed_criterion"
          },
          {
            "$ref": "#/$defs/abstained_criterion"
          }
        ]
      }
    }
  },
  "$defs": {
    "reference": {
      "description": "Exact canonical reference text. Producers must not rely on consumer-side trimming or normalization.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "rater_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rater_family_ref",
        "provider_ref",
        "implementation_revision_ref",
        "instruction_revision_ref",
        "response_schema_revision_ref",
        "workflow_mode_ref",
        "modality_channel_ref"
      ],
      "properties": {
        "rater_family_ref": {
          "$ref": "#/$defs/reference"
        },
        "provider_ref": {
          "$ref": "#/$defs/reference"
        },
        "implementation_revision_ref": {
          "$ref": "#/$defs/reference"
        },
        "instruction_revision_ref": {
          "$ref": "#/$defs/reference"
        },
        "response_schema_revision_ref": {
          "$ref": "#/$defs/reference"
        },
        "workflow_mode_ref": {
          "$ref": "#/$defs/reference"
        },
        "modality_channel_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "uncertainty": {
      "enum": ["low", "medium", "high"]
    },
    "review_signals": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "observed_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "category_anchor_ref",
        "evidence_reference_ids",
        "uncertainty",
        "review_signal_refs",
        "reason_ref"
      ],
      "properties": {
        "status": {
          "const": "observed"
        },
        "category_anchor_ref": {
          "$ref": "#/$defs/reference"
        },
        "evidence_reference_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "review_signal_refs": {
          "$ref": "#/$defs/review_signals"
        },
        "reason_ref": {
          "type": "null"
        }
      }
    },
    "abstained_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "category_anchor_ref",
        "evidence_reference_ids",
        "uncertainty",
        "review_signal_refs",
        "reason_ref"
      ],
      "properties": {
        "status": {
          "const": "abstained"
        },
        "category_anchor_ref": {
          "type": "null"
        },
        "evidence_reference_ids": {
          "type": "array",
          "maxItems": 0
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "review_signal_refs": {
          "$ref": "#/$defs/review_signals"
        },
        "reason_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    }
  }
}
