{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextualwisdomlab.github.io/fast-mlsirm/contracts/s1-fipc-consumer-verify-v1.schema.json",
  "title": "S1 two-tier GRM FIPC consumer verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sha", "build_source_sha", "build_source_sha_present",
    "loaded_extension", "loaded_extension_sha256", "row_order",
    "row_order_max_abs", "row_order_rmse", "row_order_diagnosis", "all_pass",
    "build_source_sha_authority", "evidence_class", "anchored_primary_rank",
    "anchor_identified"
  ],
  "properties": {
    "sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "build_source_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "build_source_sha_present": {"type": "boolean"},
    "build_source_sha_authority": {"const": "caller_asserted"},
    "evidence_class": {"const": "synthetic_diagnostic"},
    "loaded_extension": {"type": "string", "minLength": 1},
    "loaded_extension_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "responses_fit_eap_expected_raw": {"type": "boolean"},
    "non_unit_focal_prior": {"type": "boolean"},
    "row_order": {"type": "boolean"},
    "row_order_max_abs": {"type": ["number", "null"], "minimum": 0},
    "row_order_rmse": {"type": ["number", "null"], "minimum": 0},
    "row_order_diagnosis": {"enum": ["pass", "refit_order_dependence", "fit_error", "binding_unavailable", "not_identified"]},
    "anchored_primary_rank": {"type": "integer", "minimum": 0},
    "anchor_identified": {"type": "boolean"},
    "focal_primary_mean_error": {"type": ["array", "null"], "items": {"type": "number"}},
    "focal_primary_sd_error": {"type": ["array", "null"], "items": {"type": "number"}},
    "free_item_param_rmse": {"type": ["number", "null"], "minimum": 0},
    "anchor_rows_fixed": {"type": "boolean"},
    "convergence_failure": {"type": "boolean"},
    "orthogonal_specific_prior_fixed": {"type": "boolean"},
    "wrong_model_reject": {"type": "boolean"},
    "expected_raw_range": {"type": "null"},
    "fipc_fit_error": {"type": "string", "minLength": 1},
    "all_pass": {"type": "boolean"}
  }
}
