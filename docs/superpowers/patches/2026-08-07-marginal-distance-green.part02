+def _pairwise_euclidean_distances(
+    left: np.ndarray,
+    right: np.ndarray,
+    *,
+    eps_distance: float,
+) -> np.ndarray:
+    """Return bounded float64 pairwise distances without a 3-D tensor.
+
+    Inputs must already be finite, C-contiguous two-dimensional float64 arrays
+    with a shared positive latent width. The matrix-multiplication result is
+    mutated in place through row-norm addition, round-off clamping, epsilon
+    addition, and square root, so no second pairwise matrix is materialized.
+    """
+    if not isinstance(left, np.ndarray) or not isinstance(right, np.ndarray):
+        raise ValueError("pairwise distance inputs must be float64 arrays")
+    if left.ndim != 2 or right.ndim != 2:
+        raise ValueError("pairwise distance inputs must be two-dimensional")
+    if left.dtype != np.float64 or right.dtype != np.float64:
+        raise ValueError("pairwise distance inputs must use float64")
+    if not left.flags.c_contiguous or not right.flags.c_contiguous:
+        raise ValueError("pairwise distance inputs must be C-contiguous")
+    if left.shape[1] != right.shape[1]:
+        raise ValueError("pairwise distance inputs must share one latent dimension")
+    if left.shape[1] < 1:
+        raise ValueError("pairwise distance inputs must have a positive latent dimension")
+    if not np.all(np.isfinite(left)) or not np.all(np.isfinite(right)):
+        raise ValueError("pairwise distance inputs must be finite")
+    if (
+        isinstance(eps_distance, (bool, np.bool_))
+        or not isinstance(eps_distance, (int, float, np.integer, np.floating))
+        or not np.isfinite(float(eps_distance))
+        or float(eps_distance) <= 0.0
+    ):
+        raise ValueError("eps_distance must be finite and positive")
+
+    _validate_marginal_distance_workspaces(
+        n_items=left.shape[0],
+        n_x=right.shape[0],
+        latent_dim=left.shape[1],
+        uses_space=True,
+    )
+    distances = left @ right.T
+    distances *= -2.0
+    left_squared = np.einsum("ij,ij->i", left, left, optimize=True)
+    right_squared = np.einsum("ij,ij->i", right, right, optimize=True)
+    distances += left_squared[:, None]
+    distances += right_squared[None, :]
+    np.maximum(distances, 0.0, out=distances)
+    distances += float(eps_distance)
+    np.sqrt(distances, out=distances)
+    if not np.all(np.isfinite(distances)):
+        raise ValueError("pairwise distance result must be finite")
+    return distances
+
