@@ -88,6 +102,31 @@ def test_checked_workspace_bytes_uses_float64_byte_accounting() -> None:
         )
 
 
+
+
+def test_checked_workspace_bytes_uses_default_distance_ceiling() -> None:
+    """Omitting a limit uses the package-owned private distance byte ceiling."""
+    assert marginal._checked_marginal_workspace_bytes(
+        "default workspace",
+        2,
+        3,
+        itemsize=_FLOAT64_BYTES,
+    ) == 2 * 3 * _FLOAT64_BYTES
+
+
+def test_distance_workspace_guard_can_fail_only_the_gradient(monkeypatch) -> None:
+    """A narrow item matrix can fit while the node-by-dimension derivative cannot."""
+    monkeypatch.setattr(marginal, "MAX_MARGINAL_DISTANCE_WORKSPACE_BYTES", 1_000)
+
+    with pytest.raises(ValueError, match="item distance gradient workspace"):
+        marginal._validate_marginal_distance_workspaces(
+            n_items=1,
+            n_x=61,
+            latent_dim=3,
+            uses_space=True,
+        )
+
+
