             )
 
 
+
+
+def test_pairwise_distance_rejects_nonfinite_result() -> None:
+    """Finite coordinates whose squared norms overflow fail with a stable error."""
+    huge = np.full((1, 2), 1e308, dtype=np.float64)
+    with np.errstate(over="ignore", invalid="ignore"):
+        with pytest.raises(ValueError, match="result must be finite"):
+            marginal._pairwise_euclidean_distances(
+                huge,
+                np.zeros((1, 2), dtype=np.float64),
+                eps_distance=1e-8,
+            )
+
+
