+def _exact_nonnegative_integer(value: object, *, label: str) -> int:
+    """Return one exact non-negative integer without Boolean coercion."""
+    if (
+        isinstance(value, (bool, np.bool_))
+        or not isinstance(value, (int, np.integer))
+        or int(value) < 0
+    ):
+        raise ValueError(f"{label} must be a non-negative integer")
+    return int(value)
+
+
+def _exact_positive_integer(value: object, *, label: str) -> int:
+    """Return one exact positive integer without Boolean coercion."""
+    normalized = _exact_nonnegative_integer(value, label=label)
+    if normalized == 0:
+        raise ValueError(f"{label} must be a positive integer")
+    return normalized
+
+
+def _checked_marginal_workspace_bytes(
+    label: str,
+    *dimensions: int,
+    itemsize: int,
+    limit_bytes: int | None = None,
+) -> int:
+    """Return a bounded byte product or fail before unbounded multiplication.
+
+    Every dimension must be an exact non-negative integer. ``itemsize`` and the
+    byte ceiling must be exact positive integers. Division-before-
+    multiplication ensures even astronomically large Python integers fail
+    before an oversized intermediate product can become an allocation shape.
+    """
+    normalized_itemsize = _exact_positive_integer(itemsize, label="itemsize")
+    ceiling = _exact_positive_integer(
+        MAX_MARGINAL_DISTANCE_WORKSPACE_BYTES
+        if limit_bytes is None
+        else limit_bytes,
+        label="workspace byte limit",
+    )
+    product = normalized_itemsize
+    for dimension in dimensions:
+        try:
+            value = _exact_nonnegative_integer(
+                dimension,
+                label=f"{label} dimensions",
+            )
+        except ValueError:
+            raise ValueError(
+                f"{label} dimensions must be non-negative integers"
+            ) from None
+        if value and product > ceiling // value:
+            raise ValueError(f"{label} exceeds the {ceiling}-byte limit")
+        product *= value
+    return product
+
+
+def _pairwise_distance_workspace_bytes(
+    *,
+    n_items: int,
+    n_x: int,
+    limit_bytes: int,
+) -> int:
+    """Return live output-plus-row-norm bytes for one pairwise distance call."""
+    ceiling = _exact_positive_integer(limit_bytes, label="workspace byte limit")
+    item_count = _exact_nonnegative_integer(
+        n_items,
+        label="pairwise distance workspace dimensions",
+    )
+    node_count = _exact_nonnegative_integer(
+        n_x,
+        label="pairwise distance workspace dimensions",
+    )
+    total = 0
+    for dimensions in ((item_count, node_count), (item_count,), (node_count,)):
+        required = _checked_marginal_workspace_bytes(
+            "pairwise distance workspace",
+            *dimensions,
+            itemsize=np.dtype(np.float64).itemsize,
+            limit_bytes=ceiling,
+        )
+        if required > ceiling - total:
+            raise ValueError(
+                f"pairwise distance workspace exceeds the {ceiling}-byte limit"
+            )
+        total += required
+    return total
+
+
