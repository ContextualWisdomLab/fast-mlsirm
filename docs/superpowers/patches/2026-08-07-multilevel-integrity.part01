@@ -22,6 +26,37 @@ def _assert_error(code: str, callback) -> MultilevelContractError:
     return caught.value
 
 
+def test_atomic_contracts_require_package_factories() -> None:
+    """Direct atomic construction cannot bypass the package validation boundary."""
+    with pytest.raises(MultilevelContractError) as membership_error:
+        ContextMembership(  # type: ignore[call-arg]
+            observation_id="observation_alpha",
+            context_dimension_id="school_context",
+            context_id="school_north",
+            membership_weight=1.0,
+            membership_revision_fingerprint="a" * 64,
+        )
+    assert membership_error.value.code == "unverified_context_membership"
+
+    with pytest.raises(MultilevelContractError) as occasion_error:
+        TemporalOccasion(  # type: ignore[call-arg]
+            respondent_id="respondent_alpha",
+            occasion_id="occasion_alpha",
+            sequence_index=0,
+            time_offset_milliseconds=0,
+            occasion_revision_fingerprint="b" * 64,
+        )
+    assert occasion_error.value.code == "unverified_temporal_occasion"
+
+    with pytest.raises(MultilevelContractError) as state_error:
+        LongitudinalStateSpec(  # type: ignore[call-arg]
+            state_kind=LongitudinalStateKind.RANDOM_INTERCEPT_SLOPE,
+            autoregressive_coefficient=None,
+            include_lagged_response_dependence=False,
+        )
+    assert state_error.value.code == "unverified_longitudinal_state_spec"
+
+
