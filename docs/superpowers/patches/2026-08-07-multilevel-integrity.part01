--- a/tests/test_multilevel_contract_integrity.py
+++ b/tests/test_multilevel_contract_integrity.py
@@ -5,7 +5,11 @@ from __future__ import annotations
 import pytest
 
 from fast_mlsirm.multilevel import (
+    ContextMembership,
+    LongitudinalStateKind,
+    LongitudinalStateSpec,
     MultilevelContractError,
+    TemporalOccasion,
     build_context_membership,
     build_context_membership_design,
